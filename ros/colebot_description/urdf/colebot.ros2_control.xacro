<?xml version="1.0"?>
<!--
  ros2_control hardware for the chassis (PLAN.md §7.6). The real robot is the
  firmware's micro-ROS node, reached through topics (§4.2). Joint names must
  match colebot/components/board/include/colebot/board.h.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="colebot_wheel_joint" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="colebot_ros2_control" params="use_mock_hardware">
    <ros2_control name="colebot_chassis" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>joint_state_topic_hardware_interface/JointStateTopicSystem</plugin>
          <param name="joint_commands_topic">/chassis/wheel_commands</param>
          <param name="joint_states_topic">/chassis/wheel_states</param>
          <!-- Publish every cycle. The default (1e-5) stops publishing once the
               wheels reach speed, which trips the firmware's command timeout. -->
          <param name="trigger_joint_command_threshold">-1</param>
        </xacro:unless>
      </hardware>
      <xacro:colebot_wheel_joint name="left_wheel_joint"/>
      <xacro:colebot_wheel_joint name="right_wheel_joint"/>
    </ros2_control>
  </xacro:macro>
</robot>
