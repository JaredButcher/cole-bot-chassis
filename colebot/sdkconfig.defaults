CONFIG_IDF_TARGET="esp32c6"

# ESP32-C6-DevKitC-1: 8 MB flash. One large factory app: WiFi, Ethernet and libmicroros
# don't fit the default 1 MB app partition.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Console and logs on the native USB port (USB-Serial-JTAG, GPIO 12/13).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 1 ms tick, so the 1 kHz motor task can run on vTaskDelayUntil.
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
